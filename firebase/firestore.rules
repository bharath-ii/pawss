rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// PAWWS — Firestore Security Rules
// Production-grade security. Zero trust on client.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isPartner() {
      return hasRole('partner');
    }



    // ─── USERS ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can read their own profile; admin can read all
      allow read: if isCurrentUser(userId) || isAdmin();

      // Users can update their own profile but NOT role, payment fields
      allow update: if isCurrentUser(userId) &&
                       !('role' in request.resource.data) &&
                       !('isDeleted' in request.resource.data);

      // Only server can create user docs (via Cloud Function trigger)
      allow create: if isAdmin() || isCurrentUser(userId);

      // Nobody can delete user documents (soft delete via Cloud Function)
      allow delete: if false;

      // ─── ADDRESSES SUBCOLLECTION ────────────────────────────────────────
      match /addresses/{addressId} {
        allow read, write: if isCurrentUser(userId);
        allow read: if isAdmin();
      }
    }

    // ─── PETS ──────────────────────────────────────────────────────────────
    match /pets/{petId} {
      // Owner reads their pets
      allow read: if isAuthenticated() &&
                     (resource.data.ownerId == request.auth.uid || isAdmin());

      // Partner can read pet info
      allow read: if isPartner();

      allow create: if isAuthenticated() &&
                       request.resource.data.ownerId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;

      allow delete: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;
    }

    // ─── PARTNERS ──────────────────────────────────────────────────────────
    match /partners/{partnerId} {
      // Anyone authenticated can read approved partner profiles (discovery)
      allow read: if isAuthenticated() &&
                     (resource.data.status == 'approved' || isAdmin() ||
                      resource.data.uid == request.auth.uid);

      // Partners can update their own profile (except status, uid)
      allow update: if isAuthenticated() &&
                       resource.data.uid == request.auth.uid &&
                       !('status' in request.resource.data) &&
                       !('uid' in request.resource.data) &&
                       !('rating' in request.resource.data) &&
                       !('totalReviews' in request.resource.data);

      // Admin can update anything
      allow update: if isAdmin();

      // New partner applications (customer creating partner profile)
      allow create: if isAuthenticated() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == 'pending';

      allow delete: if isAdmin();
    }

    // ─── SERVICES ──────────────────────────────────────────────────────────
    match /services/{serviceId} {
      // Anyone authenticated can read active services
      allow read: if isAuthenticated() &&
                     (resource.data.isActive == true || isAdmin() ||
                      resource.data.partnerId == request.auth.token.partnerId);

      // Only the owning partner can write services
      allow create: if isAuthenticated() &&
                       request.resource.data.partnerId == request.auth.token.partnerId;

      allow update: if isAuthenticated() &&
                       resource.data.partnerId == request.auth.token.partnerId &&
                       !('partnerId' in request.resource.data);

      allow delete: if isAuthenticated() &&
                       resource.data.partnerId == request.auth.token.partnerId;

      allow write: if isAdmin();
    }

    // ─── BOOKINGS ──────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Customer can read their own bookings
      allow read: if isAuthenticated() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.partnerId == request.auth.token.partnerId ||
                      isAdmin());

      // Customers CANNOT directly create bookings — must use Cloud Function
      allow create: if false;

      // Customers cannot modify payment status or booking completion
      // Partners cannot modify customer data fields
      allow update: if isAuthenticated() &&
                       resource.data.customerId == request.auth.uid &&
                       !('paymentStatus' in request.resource.data) &&
                       !('bookingStatus' in request.resource.data) &&
                       !('finalAmount' in request.resource.data) &&
                       !('partnerId' in request.resource.data);

      // No direct delete
      allow delete: if isAdmin();
    }

    // ─── REVIEWS ───────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Public read for approved reviews
      allow read: if isAuthenticated();

      // Reviews only via Cloud Function
      allow create: if false;

      // Partners cannot modify reviews
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── PAYMENTS ──────────────────────────────────────────────────────────
    match /payments/{paymentId} {
      // Customer can read their own payment records
      allow read: if isAuthenticated() &&
                     (resource.data.customerId == request.auth.uid ||
                      resource.data.partnerId == request.auth.token.partnerId ||
                      isAdmin());

      // Payment records only created/updated by Cloud Functions
      allow create, update, delete: if false;
    }

    // ─── CHATS ─────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants;

      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants;

      allow delete: if isAdmin();

      // ─── MESSAGES SUBCOLLECTION ─────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;

        allow create: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid;

        allow update: if isAuthenticated() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         !('senderId' in request.resource.data) &&
                         !('text' in request.resource.data);

        allow delete: if false;
      }
    }

    // ─── NOTIFICATIONS ─────────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
                     resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['isRead']);

      allow create, delete: if isAdmin();
    }

    // ─── COUPONS ───────────────────────────────────────────────────────────
    match /coupons/{couponId} {
      // Read by authenticated users (validation in Cloud Function)
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── CATEGORIES ────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── PAYOUTS ───────────────────────────────────────────────────────────
    match /payouts/{payoutId} {
      allow read: if isAuthenticated() &&
                     (resource.data.partnerId == request.auth.token.partnerId || isAdmin());
      allow write: if isAdmin();
    }

    // ─── AVAILABILITY ──────────────────────────────────────────────────────
    match /availability/{slotId} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated() &&
                                request.resource.data.partnerId == request.auth.token.partnerId;

      allow delete: if isAuthenticated() &&
                       resource.data.partnerId == request.auth.token.partnerId;
    }

    // ─── FAVORITES ─────────────────────────────────────────────────────────
    match /favorites/{favoriteId} {
      allow read, write: if isAuthenticated() &&
                            resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid;
    }
  }
}
